# Allow exposing Forgejo Actions default environment variables to the invoked superuser processes
#
# References:
#
# * Command environment | Sudoers Manual | Sudo
#   https://www.sudo.ws/docs/man/sudoers.man/#Command_environment
# * Default environment - variablesVariables - GitHub Docs
#   https://docs.github.com/en/actions/learn-github-actions/variables#default-environment-variables
# * Forgejo Actions | Reference | Forgejo – Beyond coding. We forge.
#   https://forgejo.org/docs/v15.0/user/actions/reference/#env-1
#
# Copyright 2024 林博仁(Buo-ren Lin) <buo.ren.lin@gmail.com>
# Copyright 2026 OSS Integral Institute Co., Ltd. <https://www.ossii.com.tw/contact>
# SPDX-License-Identifier: CC-BY-SA-4.0

# Whether we are in an CI environment
Defaults env_keep += "CI"

# Variables defined by Forgejo
Defaults env_keep += "FORGEJO_*"

# Variables defined by the GitHub Action runners
Defaults env_keep += "RUNNER_*"
